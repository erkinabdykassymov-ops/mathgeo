<!doctype html>
<html lang="kk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#f2f6fc">
<style>html,body{margin:0}</style>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
</head>
<body>
<title>Кеңістік 3D</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;700;800&display=swap">
<style>
/* Layout: one phone-width column. Bottom tab bar (Курс, Практика, Сөздік, ҰБТ, Профиль); a lesson player replaces the tabs while a lesson runs.
   One bright theme on purpose: the tool is used on classroom panels and in daylight. */
:root {
  --bg: #f2f6fc;
  --card: #ffffff;
  --ink: #1b2742;
  --muted: #5a6985;
  --line: #d6dff0;
  --accent: #2f62d6;
  --accent-dark: #234db0;
  --accent-soft: #e4ecfc;
  --ok: #17825a;
  --ok-soft: #dff4ea;
  --bad: #c93a54;
  --bad-soft: #fde7eb;
  --warm: #d9682b;
  --font: 'Nunito', system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', sans-serif;
  color-scheme: light;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body {
  background: var(--bg);
  color: var(--ink);
  font: 500 15px/1.5 var(--font);
  padding-inline: 16px;
  padding-block: 18px 96px;
}
.app { max-width: 520px; margin: 0 auto; }
h1 { font-size: 25px; line-height: 1.15; font-weight: 800; margin: 0; letter-spacing: -0.01em; }
h2 { font-size: 19px; line-height: 1.25; font-weight: 800; margin: 0; text-wrap: balance; }
h3 { font-size: 16px; line-height: 1.3; font-weight: 800; margin: 0; }
p { margin: 0; }
button { font-family: var(--font); }
.sub { color: var(--muted); font-size: 14px; margin-top: 2px; }
.view { display: flex; flex-direction: column; gap: 14px; }
.topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.pill { font-size: 13px; font-weight: 800; background: var(--card); border: 1px solid var(--line); border-radius: 99px; padding: 6px 12px; color: var(--warm); white-space: nowrap; font-variant-numeric: tabular-nums; }

.card { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
.hero { background: var(--accent-soft); border: 1px solid #c3d4f5; border-radius: 20px; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
.eyebrow { font-size: 12px; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: var(--accent-dark); }
.hint { color: var(--muted); font-size: 14px; }
.chip { align-self: flex-start; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-dark); background: var(--accent-soft); padding: 4px 10px; border-radius: 99px; }

.bar { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 5px; }
.bar i { height: 7px; border-radius: 4px; background: #dbe3f2; }
.bar i.ok { background: var(--ok); }
.bar i.bad { background: var(--bad); }
.bar i.done { background: #8fb0f5; }
.bar i.cur { background: var(--accent); }

.btn {
  font: 800 16px var(--font); border-radius: 14px; padding: 13px 16px; cursor: pointer; min-width: 0;
  border: 2px solid var(--line); background: var(--card); color: var(--ink); border-bottom-width: 4px; text-align: center;
}
.btn:hover { border-color: #b9c8e6; }
.btn.primary { background: var(--accent); border-color: var(--accent-dark); color: #fff; }
.btn.primary:hover { background: #2a58c4; }
.btn.small { font-size: 13px; padding: 6px 10px; border-bottom-width: 3px; border-radius: 10px; }
.btn:disabled { opacity: 0.55; cursor: default; }
.btn.ok { background: var(--ok-soft); border-color: var(--ok); color: var(--ok); }
.btn.bad { background: var(--bad-soft); border-color: var(--bad); color: var(--bad); }
.btn:focus-visible, .tab:focus-visible, .cell:focus-visible, .nav-btn:focus-visible, .lesson:focus-visible, .icon-btn:focus-visible { outline: 3px solid #8fb0f5; outline-offset: 2px; }
.btn.on { background: var(--accent-soft); border-color: var(--accent); color: var(--accent-dark); }

.topic { display: flex; flex-direction: column; gap: 10px; }
.topic-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
.topic-head span { font-size: 13px; font-weight: 800; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
.lessons { display: flex; flex-direction: column; gap: 6px; }
.lesson {
  display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; cursor: pointer;
  background: #f6f9fe; border: 2px solid var(--line); border-radius: 14px; padding: 10px 12px; color: var(--ink); font: 700 15px var(--font);
}
.lesson:hover { border-color: #b3c4e6; }
.lesson .t { flex: 1; min-width: 0; }
.lesson .n { font-size: 12.5px; color: var(--muted); font-weight: 700; white-space: nowrap; }
.dot { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: 14px; background: #e1e9f9; color: var(--accent-dark); flex: none; }
.dot.done { background: var(--ok); color: #fff; }

.stage { position: relative; border-radius: 14px; background: radial-gradient(circle at 50% 40%, #ffffff 0%, #eef3fc 100%); border: 1px solid var(--line); overflow: hidden; }
.stage canvas { display: block; width: 100%; height: 320px; touch-action: none; cursor: grab; }
.stage canvas:active { cursor: grabbing; }
.stage .reset { position: absolute; top: 8px; right: 8px; }
.nogl { padding: 40px 16px; text-align: center; color: var(--muted); }

.player { display: flex; flex-direction: column; gap: 12px; }
.p-top { display: flex; align-items: center; gap: 12px; }
.p-top .bar { flex: 1; }
.icon-btn { width: 40px; height: 40px; border-radius: 12px; border: 2px solid var(--line); border-bottom-width: 4px; background: var(--card); font: 800 20px var(--font); color: var(--ink); cursor: pointer; flex: none; }
.answers { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.fb { border-radius: 14px; padding: 12px 14px; font-size: 14.5px; }
.fb b { display: block; font-size: 16px; margin-bottom: 2px; }
.fb.ok { background: var(--ok-soft); color: #0f5d40; }
.fb.bad { background: var(--bad-soft); color: #8d2438; }
.score { font-size: 54px; font-weight: 800; line-height: 1; color: var(--accent-dark); font-variant-numeric: tabular-nums; }
.score span { font-size: 28px; color: var(--muted); }

.tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; background: #e2e9f6; padding: 5px; border-radius: 14px; }
.tab { font: 800 15px var(--font); color: var(--muted); background: transparent; border: 0; padding: 10px 8px; border-radius: 10px; cursor: pointer; min-width: 0; }
.tab[aria-selected="true"] { background: var(--card); color: var(--accent-dark); box-shadow: 0 1px 3px rgba(27, 39, 66, 0.15); }
.row { display: flex; flex-wrap: wrap; gap: 8px; }
.status { border-radius: 12px; padding: 10px 12px; font-size: 14.5px; background: #f4f7fd; color: var(--ink); }
.status.ok { background: var(--ok-soft); color: #0f5d40; }
.status.bad { background: var(--bad-soft); color: #8d2438; }
.grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 5px; }
.cell { aspect-ratio: 1; min-width: 0; border-radius: 8px; border: 2px solid var(--line); background: #f6f9fe; font: 800 20px var(--font); color: #fff; cursor: pointer; padding: 0; }
.cell:hover { border-color: #b3c4e6; }
.cell.on { background: var(--accent); border-color: var(--accent-dark); }
.cell.bad { background: var(--bad); border-color: #a22c42; }
.opp { font-size: 14px; color: var(--muted); }
.opp b { color: var(--ink); }

.stats4 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.stat { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 2px; }
.stat b { font-size: 28px; line-height: 1.1; font-weight: 800; color: var(--accent-dark); font-variant-numeric: tabular-nums; }
.stat span { font-size: 13px; color: var(--muted); font-weight: 700; }
.mini span:last-child { white-space: nowrap; }
.mini { display: flex; justify-content: space-between; gap: 10px; padding: 8px 12px; background: #f4f7fd; border-radius: 10px; font-weight: 700; font-variant-numeric: tabular-nums; }

#nav { position: fixed; left: 0; right: 0; bottom: 0; background: var(--card); border-top: 1px solid var(--line); padding: 6px 10px calc(8px + env(safe-area-inset-bottom, 0px)); }
#nav .in { max-width: 520px; margin: 0 auto; display: grid; grid-template-columns: repeat(5, 1fr); gap: 2px; }
.nav-btn { display: flex; flex-direction: column; align-items: center; gap: 2px; border: 0; background: transparent; color: var(--muted); font: 800 12px var(--font); padding: 6px 2px; border-radius: 12px; cursor: pointer; min-width: 0; }
.nav-btn svg { width: 24px; height: 24px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.nav-btn[aria-selected="true"] { color: var(--accent-dark); background: var(--accent-soft); }
.foot { font-size: 12.5px; color: var(--muted); text-align: center; }

.tabs.three { grid-template-columns: repeat(3, 1fr); }
.tabs.three .tab { font-size: 13.5px; padding: 10px 4px; }
.note { background: #fff7e6; border: 1px solid #f1d9a0; color: #6b4b00; border-radius: 12px; padding: 10px 12px; font-size: 14px; }
.actions .btn { flex: 1 1 auto; }
.actions .btn.small { flex: 0 0 auto; }
.pchip { display: flex; align-items: center; gap: 8px; background: #f4f7fd; border: 1px solid var(--line); border-radius: 12px; padding: 6px 8px; width: 100%; font-size: 14px; }
.pdot { width: 26px; height: 26px; border-radius: 50%; color: #fff; display: grid; place-items: center; font-weight: 800; flex: none; }
.ptxt { flex: 1; min-width: 0; }
.px { border: 0; background: transparent; color: var(--muted); font: 800 20px var(--font); width: 32px; height: 32px; cursor: pointer; border-radius: 8px; }
.px:hover { background: #e4ebf8; }
.chip-btn { font: 800 15px var(--font); min-width: 44px; height: 40px; padding: 0 10px; border-radius: 10px; border: 2px solid var(--line); background: var(--card); color: var(--ink); cursor: pointer; }
.chip-btn.on { background: var(--accent); border-color: var(--accent-dark); color: #fff; }
.dims { background: #f6f9fe; border: 1px solid var(--line); border-radius: 12px; padding: 8px 12px; }
.dims summary { font-weight: 800; cursor: pointer; padding: 4px 0; }
.dim { display: grid; grid-template-columns: 82px 1fr 34px; align-items: center; gap: 8px; padding: 6px 0; font-size: 14px; }
.dim input { width: 100%; accent-color: var(--accent); }
.dim b { text-align: right; font-variant-numeric: tabular-nums; }
.panel { background: #f6f9fe; border: 1px solid var(--line); border-radius: 14px; padding: 12px; display: flex; flex-direction: column; gap: 10px; }
.panel-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.panel .row .btn { flex: 1; }
.log { max-height: 190px; overflow: auto; display: flex; flex-direction: column; gap: 6px; font-size: 13.5px; }
.logline { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 7px 10px; }
textarea { width: 100%; font: 500 15px/1.45 var(--font); color: var(--ink); background: #f6f9fe; border: 2px solid var(--line); border-radius: 12px; padding: 10px 12px; resize: vertical; }
textarea:focus-visible { outline: 3px solid #8fb0f5; outline-offset: 1px; }
.file { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 700; color: var(--muted); }
.file input { font: 500 14px var(--font); }
.gl summary { font-weight: 800; cursor: pointer; }
.gl-it { padding: 8px 0 0; border-top: 1px solid var(--line); }
.gl-it b { font-size: 15px; }
#gl-q { font: 500 16px var(--font); padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); color: var(--text); width: 100%; box-sizing: border-box; }
</style>

<div class="app">
  <main id="main">
    <!-- Курс -->
    <section class="view" id="v-course">
      <div class="topbar">
        <div>
          <h1>Кеңістік 3D</h1>
          <p class="sub">Стереометрия · 10–11 сынып · ҰБТ</p>
        </div>
        <span class="pill" id="streak-pill"></span>
      </div>
      <div class="hero">
        <span class="eyebrow" id="hero-eyebrow"></span>
        <h2 id="hero-title"></h2>
        <p class="hint" id="hero-sub"></p>
        <div class="bar" id="hero-bar"></div>
        <button class="btn primary" id="hero-go" type="button"></button>
      </div>
      <div id="topics" class="view"></div>
    </section>

    <!-- Практика -->
    <section class="view" id="v-sandbox" hidden>
      <div>
        <h1>Практика</h1>
        <p class="sub">Есептерді өзің тұрғыз: қима, жазба, 3D есеп</p>
      </div>
      <div class="tabs" role="tablist" id="sb-tabs">
        <button class="tab" role="tab" id="sb-tab-sec" aria-selected="true">Қима</button>
        <button class="tab" role="tab" id="sb-tab-net" aria-selected="false">Жазба → куб</button>
        <button class="tab" role="tab" id="sb-tab-ai" aria-selected="false" hidden>Есеп → 3D</button>
      </div>

      <div class="card" id="sb-sec">
        <div class="tabs" role="tablist" aria-label="Режим">
          <button class="tab" role="tab" id="mode-simple" aria-selected="true">Қарапайым</button>
          <button class="tab" role="tab" id="mode-adv" aria-selected="false">Кеңейтілген</button>
        </div>
        <p class="hint" id="sb-hint">Қарапайым режим: нүктелер төбеге немесе қырдың ортасына қойылады. «Қию» түймесі қиманы көрсетеді, «Қадамдап талдау» тұрғызуды түсіндіреді.</p>
        <p class="note" id="sb-note" hidden></p>
        <div class="row" id="sb-figs"></div>
        <div class="stage">
          <canvas id="cv2" aria-label="3D фигура. Нүкте қою үшін түртіңіз, айналдыру үшін сүйреңіз."></canvas>
          <button class="btn small reset" id="sb-reset" type="button">Бастапқы көрініс</button>
        </div>
        <details class="dims">
          <summary>Пропорциялар</summary>
          <label class="dim"><span>Ұзындығы</span><input type="range" id="dim-x" min="0.6" max="1.6" step="0.05" value="1"><b id="dim-x-v">1</b></label>
          <label class="dim"><span>Биіктігі</span><input type="range" id="dim-y" min="0.6" max="1.6" step="0.05" value="1"><b id="dim-y-v">1</b></label>
          <label class="dim"><span>Ені</span><input type="range" id="dim-z" min="0.6" max="1.6" step="0.05" value="1"><b id="dim-z-v">1</b></label>
          <button class="btn small" id="dims-reset" type="button">Түзу пішінге қайтару</button>
        </details>
        <div class="row" id="sb-chips"></div>
        <div class="status" id="sb-status" aria-live="polite"></div>
        <div class="row actions">
          <button class="btn primary" id="sb-cut" type="button">Қию</button>
          <button class="btn" id="sb-analyze" type="button">Қадамдап талдау</button>
          <button class="btn primary" id="sb-build" type="button">Өзім тұрғызамын</button>
          <button class="btn small" id="sb-back" type="button" hidden>Нүктелерге оралу</button>
          <button class="btn small" id="sb-clear" type="button">Тазалау</button>
        </div>
        <div id="sb-panel" hidden>
          <div id="sb-an" class="panel" hidden>
            <div class="panel-top"><span class="chip" id="an-kind"></span><span class="hint" id="an-count"></span></div>
            <p id="an-text"></p>
            <div class="row"><button class="btn" id="an-prev" type="button">Алдыңғы</button><button class="btn primary" id="an-next" type="button">Келесі</button></div>
          </div>
          <div id="sb-own" class="panel" hidden>
            <div class="panel-top"><span class="chip">Өзім тұрғызамын</span><span class="hint" id="own-prog"></span></div>
            <div class="status" id="own-status" aria-live="polite"></div>
            <div class="log" id="own-log"></div>
            <div class="row"><button class="btn" id="own-hint" type="button">Көмек</button><button class="btn" id="own-solve" type="button">Шешімді көрсет</button></div>
          </div>
        </div>
      </div>

      <div class="card" id="sb-ai" hidden>
        <p class="hint">Есептің мәтінін жаз немесе сызбасының суретін жүкте. Claude фигураны және нүктелерді анықтап, Практикаға салып береді. Нәтижені есеп шартымен салыстырып тексер.</p>
        <textarea id="ai-text" rows="5" placeholder="Мысалы: ABCDA₁B₁C₁D₁ кубында M нүктесі AB қырының ортасы, N нүктесі CC₁ қырының ортасы, K нүктесі A₁D₁ қырының ортасы. MNK жазықтығымен қиманы тұрғыз."></textarea>
        <label class="file" id="ai-photo-wrap" hidden><span>Сурет (міндетті емес)</span><input type="file" id="ai-photo" accept="image/*"></label>
        <button class="btn primary" id="ai-go" type="button">3D-ге ауыстыру</button>
        <div class="status" id="ai-status" aria-live="polite" hidden></div>
        <p class="foot">Бұл функция Claude-ты қолданады: нәтиже бетті ашқан адамның Claude лимитінен есептеледі, алғашқы рет рұқсат сұралады.</p>
      </div>

      <div class="card" id="sb-net" hidden>
        <p class="hint">Торда 6 шаршыны түртіп таңда. Тренажер оның кубқа жиналатынын тексереді және әр шаршы қай жаққа түсетінін көрсетеді.</p>
        <div class="grid" id="grid" role="group" aria-label="Жазба торы"></div>
        <div class="row" id="presets"></div>
        <div class="status" id="nstatus" aria-live="polite"></div>
        <div class="stage"><canvas id="cv3" aria-label="Куб. Айналдыру үшін сүйреңіз."></canvas></div>
        <p class="opp" id="opp"></p>
      </div>
    </section>

    <!-- Сөздік -->
    <section class="view" id="v-gloss" hidden>
      <div>
        <h1>Сөздік</h1>
        <p class="sub">10–11 сынып геометрия оқулықтарының терминдері</p>
      </div>
      <input id="gl-q" type="search" placeholder="Термин іздеу" aria-label="Термин іздеу">
      <button class="btn primary" id="gl-quiz" type="button">Терминдер сынағы · 5 сұрақ</button>
      <div id="gl-list" class="view"></div>
    </section>

    <!-- ҰБТ -->
    <section class="view" id="v-ubt" hidden>
      <div>
        <h1>ҰБТ режимі</h1>
        <p class="sub">Стереометрия есептері: бұрыш, қашықтық, көлем</p>
      </div>
      <div class="hero">
        <span class="eyebrow">Сынақ тапсырма</span>
        <h2>Аралас жаттығу</h2>
        <p class="hint">Барлық тақырыптан 5 есеп. Әр есептің шешуі жауаптан кейін көрсетіледі.</p>
        <button class="btn primary" id="ubt-mix" type="button">Бастау</button>
      </div>
      <div id="ubt-topics" class="view"></div>
    </section>

    <!-- Профиль -->
    <section class="view" id="v-profile" hidden>
      <div>
        <h1>Профиль</h1>
        <p class="sub" id="pf-name"></p>
      </div>
      <div class="stats4" id="pf-stats"></div>
      <div class="card">
        <h3>Тақырыптар бойынша</h3>
        <div id="pf-topics" class="view" style="gap:8px"></div>
      </div>
      <button class="btn" id="pf-reset" type="button">Прогресті өшіру</button>
    </section>
  </main>

  <!-- Сабақ ойыншысы -->
  <section class="player" id="player" hidden>
    <div class="p-top">
      <button class="icon-btn" id="p-close" type="button" aria-label="Жабу">×</button>
      <div class="bar" id="p-bar"></div>
    </div>
    <div id="p-play" class="player">
      <div class="stage">
        <canvas id="cv1" aria-label="3D фигура. Айналдыру үшін сүйреңіз."></canvas>
        <button class="btn small reset" id="p-reset" type="button">Бастапқы көрініс</button>
      </div>
      <div class="card">
        <span class="chip" id="p-chip"></span>
        <h2 id="p-title"></h2>
        <p class="hint" id="p-body"></p>
        <div class="answers" id="p-answers"></div>
        <div id="p-fb" aria-live="polite"></div>
