    var res = null, tries = 0;
    while (!res && tries++ < 500) {
      var s1 = pick(segs), s2 = pick(segs);
      if (s1 === s2 || s1[0] === s2[0] || s1[0] === s2[1] || s1[1] === s2[0] || s1[1] === s2[1]) continue;
      var u = spec.V[s1[1]].clone().sub(spec.V[s1[0]]), v = spec.V[s2[1]].clone().sub(spec.V[s2[0]]);
      var w = spec.V[s2[0]].clone().sub(spec.V[s1[0]]);
      if (u.clone().cross(v).length() < 1e-6) continue;
      if (Math.abs(u.dot(v.clone().cross(w))) < 1e-6) continue;
      var c = Math.abs(u.dot(v)) / (u.length() * v.length());
      var deg = Math.round(Math.acos(Math.min(1, c)) * 180 / Math.PI);
      if ([45, 60, 90].indexOf(deg) < 0) continue;
      res = { s1: s1, s2: s2, deg: deg, u: u, v: v };
    }
    var nm = function (s) { return spec.names[s[0]] + spec.names[s[1]]; };
    var cs = { 45: '√2/2', 60: '1/2', 90: '0' }[res.deg];
    var m = mix(res.deg + '°', ['30°', '45°', '60°', '90°']);
    return choiceStep({
      chip: 'Куб · айқас түзулер бұрышы', prompt: nm(res.s1) + ' және ' + nm(res.s2) + ' айқас түзулері арасындағы бұрышты тап.',
      hint: 'Бір түзуді өзіне параллель көшір, сонда қиылысатын түзулер шығады. Немесе векторлармен есепте.',
      answers: m.answers, correct: m.correct,
      solution: 'Куб қырын 2 деп алсақ, ' + nm(res.s1) + ' = ' + res.u.length().toFixed(2).replace(/\.?0+$/, '') + ', ' + nm(res.s2) + ' = ' + res.v.length().toFixed(2).replace(/\.?0+$/, '') + '. Бағыттаушы векторлардың скаляр көбейтіндісі ' + Math.abs(res.u.dot(res.v)).toFixed(0) + ', сондықтан cos φ = ' + cs + ' және φ = ' + res.deg + '°.',
      build: function (viewer) {
        var fig = openFig(viewer, spec, 0.05, -0.55, true);
        fig.vseg(res.s1[0], res.s1[1], COL.sel, 0.055); fig.vseg(res.s2[0], res.s2[1], COL.warm, 0.055);
