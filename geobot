  /* ----- placing points ----- */
  function sbSnap(x, y) {
    var spec = SB.spec, i, best = null, bd = 1e9;
    for (i = 0; i < spec.V.length; i++) {
      var p = V2.project(spec.V[i]), d = Math.hypot(p.x - x, p.y - y);
      if (d < bd) { bd = d; best = { t: 'v', i: i }; }
    }
    if (bd < 22) return best;
    bd = 1e9; best = null;
    if (!SB.adv) {
      for (i = 0; i < spec.edges.length; i++) {
        var q = V2.project(spec.edges[i].mid), dq = Math.hypot(q.x - x, q.y - y);
        if (dq < bd) { bd = dq; best = { t: 'e', i: i, u: 0.5 }; }
      }
      return bd < 26 ? best : null;
    }
    var bu = 0.5;
    for (i = 0; i < spec.edges.length; i++) {
      var a = V2.project(spec.V[spec.edges[i].a]), b = V2.project(spec.V[spec.edges[i].b]);
      var vx = b.x - a.x, vy = b.y - a.y;
      var u = ((x - a.x) * vx + (y - a.y) * vy) / (vx * vx + vy * vy || 1);
      u = Math.max(0, Math.min(1, u));
      var dd = Math.hypot(a.x + u * vx - x, a.y + u * vy - y);
      if (dd < bd) { bd = dd; best = i; bu = u; }
    }
    if (bd < 14) {
      [0.5, 0.25, 0.75, 1 / 3, 2 / 3].forEach(function (s) { if (Math.abs(bu - s) < 0.045) bu = s; });
      bu = Math.max(0.05, Math.min(0.95, bu));
      return { t: 'e', i: best, u: bu };
    }
    var hit = V2.rayHit(x, y, SB.fig.faceMeshes);
    if (hit) {
      var fi = hit.object.userData.id, f = spec.F[fi], loc = V2.root.worldToLocal(hit.point.clone());
      for (var k = 1; k < f.length - 1; k++) {
